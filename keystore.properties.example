# Copy to `keystore.properties` at the repository root (git-ignored) and fill
# in real values to sign release builds locally. CI reads the KEYSTORE_*
# environment variables instead (see .github/workflows/android.yml).
# storeFile=releases/opencode.jks        # path relative to the repository root
# storePassword=changeme
# keyAlias=opencode
# keyPassword=changeme
