<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android-12 counterpart of data_extraction_rules.xml (minSdk 26 still
    runs on API 26-30): exclude every app-owned domain. "adb backup" is not
    opted into either (android:allowBackup=false in the manifest).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
